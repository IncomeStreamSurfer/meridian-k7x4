---
import Base from '../layouts/Base.astro';
---

<Base
  title="Meridian — Specialty Coffee, Coming Soon"
  description="Meridian is a new specialty coffee brand arriving soon. Join the waitlist for early access, origin stories, and first-roast drops."
  noindex={true}
>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <div class="max-w-xl">
      <p class="font-serif text-[0.9rem] uppercase tracking-[0.32em] text-[color:var(--color-smoke)]">Meridian · Specialty Coffee</p>
      <h1 class="font-serif mt-8 text-4xl md:text-5xl leading-[1.05] animate-slowpulse">
        Building something<br />worth brewing.
      </h1>
      <p class="mt-8 text-base text-[color:var(--color-smoke)]">
        The site is coming to life — refresh to watch it take shape.
      </p>
    </div>
  </main>
</Base>
