---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://meridian-k7x4.vercel.app';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Meridian Coffee Waitlist Confirmed',
    url: `${siteUrl}/thanks`,
    description:
      "Thanks for joining the Meridian waitlist. We'll be in touch before launch with origin stories, early access, and first-roast news.",
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Waitlist Confirmed', item: `${siteUrl}/thanks` },
    ],
  },
];

const shareText = encodeURIComponent(
  'Just joined the waitlist for Meridian — a new specialty coffee brand sourcing and roasting with editorial precision.'
);
const shareUrl = encodeURIComponent(siteUrl);
---

<Base
  title="You're In | Meridian Specialty Coffee"
  description="Thanks for joining the Meridian waitlist. We'll be in touch before launch with origin stories, early access, and first-roast news."
  structuredData={structuredData}
  noindex={true}
>
  <Header current="/thanks" />

  <main class="max-w-3xl mx-auto px-6 md:px-10 pt-16 md:pt-28 pb-20 text-center">
    <p class="font-serif text-[0.72rem] uppercase tracking-[0.34em] text-[color:var(--color-smoke)]">
      Waitlist · Confirmed
    </p>
    <h1 class="font-serif mt-8 text-[2.2rem] sm:text-4xl md:text-5xl leading-[1.08] tracking-[-0.01em]">
      You’re on the list.<br />
      <span class="italic text-[color:var(--color-ember)]">Good taste confirmed.</span>
    </h1>

    <p class="mt-10 max-w-xl mx-auto text-lg leading-relaxed text-[color:var(--color-smoke)]">
      Thanks for joining the Meridian waitlist. We’ll be in touch before launch with origin stories, early access to our first roast drops, and the first field note from our buying trip.
    </p>

    <!-- WHAT HAPPENS NEXT -->
    <div class="mt-14 grid sm:grid-cols-3 gap-6 text-left">
      <div class="border border-current/15 p-6">
        <p class="font-serif italic text-[0.72rem] uppercase tracking-wider text-[color:var(--color-ember)]">Step 01</p>
        <p class="font-serif text-base mt-3 leading-snug">A welcome note lands in your inbox.</p>
      </div>
      <div class="border border-current/15 p-6">
        <p class="font-serif italic text-[0.72rem] uppercase tracking-wider text-[color:var(--color-ember)]">Step 02</p>
        <p class="font-serif text-base mt-3 leading-snug">Field notes from our trips to origin, before launch.</p>
      </div>
      <div class="border border-current/15 p-6">
        <p class="font-serif italic text-[0.72rem] uppercase tracking-wider text-[color:var(--color-ember)]">Step 03</p>
        <p class="font-serif text-base mt-3 leading-snug">48-hour early access on the first release.</p>
      </div>
    </div>

    <!-- SHARE -->
    <div class="mt-16">
      <p class="font-serif text-[0.72rem] tracking-[0.28em] uppercase text-[color:var(--color-smoke)]">
        Know a coffee person?
      </p>
      <div class="mt-6 flex items-center justify-center gap-4 flex-wrap">
        <a
          href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 border border-current text-[0.72rem] tracking-[0.25em] uppercase font-serif hover:bg-current hover:text-[color:var(--color-cream)] dark:hover:text-[color:var(--color-ink)] transition-colors"
        >
          Share on X
        </a>
        <a
          href={`mailto:?subject=Meridian%20Coffee&body=${shareText}%20${shareUrl}`}
          class="px-5 py-2.5 border border-current text-[0.72rem] tracking-[0.25em] uppercase font-serif hover:bg-current hover:text-[color:var(--color-cream)] dark:hover:text-[color:var(--color-ink)] transition-colors"
        >
          Forward the link
        </a>
      </div>
    </div>

    <!-- LINKS BACK -->
    <div class="mt-20 border-t border-[color:var(--color-smoke)]/20 pt-10 flex flex-col sm:flex-row items-center justify-center gap-6 text-sm">
      <a href="/" class="font-serif text-[0.72rem] tracking-[0.25em] uppercase underline underline-offset-8 hover:text-[color:var(--color-ember)]">
        ← Back home
      </a>
      <span class="hidden sm:inline text-[color:var(--color-smoke)]">·</span>
      <a href="/about" class="font-serif text-[0.72rem] tracking-[0.25em] uppercase underline underline-offset-8 hover:text-[color:var(--color-ember)]">
        Read our story →
      </a>
    </div>
  </main>

  <Footer />
</Base>
